{
  "name": "sweepbot",
  "version": "0.1.0",
  "private": true,
  "description": "The operating system for the sweepstakes casino player ecosystem",
  "author": "Vincent Kinney <vincekinney1991@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build:flows": "pnpm --filter @sweepbot/flows run build",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "db:migrate": "pnpm --filter @sweepbot/api db:migrate",
    "db:seed": "pnpm --filter @sweepbot/api db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.8",
      "esbuild": ">=0.25.0",
      "@fastify/static": "9.1.1",
      "@protobufjs/utf8": "1.1.1",
      "@tootallnate/once": "2.0.1",
      "basic-ftp": "5.3.1",
      "brace-expansion@^1.0.0": "1.1.13",
      "brace-expansion@^2.0.0": "2.0.3",
      "brace-expansion@^5.0.0": "5.0.6",
      "defu": "6.1.5",
      "dompurify": "3.4.0",
      "fast-jwt": "6.2.4",
      "fast-uri": "3.1.2",
      "flatted": "3.4.2",
      "ip-address": "10.1.1",
      "lodash": "4.18.1",
      "node-forge": "1.4.0",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "postcss": "8.5.15",
      "protobufjs": "7.5.8",
      "tar-fs@^3.0.0": "3.1.1",
      "uuid": "11.1.1",
      "ws": "8.20.1",
      "yaml@^2.4.2": "2.8.3",
      "yaml": "2.8.3"
    }
  }
}
